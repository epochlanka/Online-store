// Clothing store database schema.
// SQLite is used for local development. To move to PostgreSQL or MySQL,
// change `provider` below and DATABASE_URL in .env, then run a new migration.
// Status/role fields are plain strings so the schema works on every provider;
// allowed values are listed in the comments and enforced by the API.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Users & accounts ----------

model User {
  id           Int             @id @default(autoincrement())
  email        String          @unique
  passwordHash String
  name         String
  phone        String?
  role         String          @default("CUSTOMER") // CUSTOMER | STAFF | ADMIN
  active       Boolean         @default(true)
  newsletter   Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  addresses    Address[]
  orders       Order[]
  sessions     Session[]
  resets       PasswordReset[]
  wishlist     WishlistItem[]
  reviews      Review[]
}

model Session {
  id        String   @id // sha256 hash of the cookie token
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordReset {
  id        String   @id // sha256 hash of the emailed token
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model Address {
  id         Int     @id @default(autoincrement())
  userId     Int
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String  @default("Home")
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  district   String
  postalCode String?
  isDefault  Boolean @default(false)
}

// ---------- Catalogue ----------

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String?
  sortOrder   Int       @default(0)
  products    Product[]
}

model Product {
  id          Int              @id @default(autoincrement())
  name        String
  slug        String           @unique
  sku         String           @unique
  description String
  material    String?
  care        String?
  price       Int // in rupees (LKR)
  salePrice   Int?
  status      String           @default("DRAFT") // ACTIVE | DRAFT
  featured    Boolean          @default(false)
  soldCount   Int              @default(0)
  categoryId  Int?
  category    Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  images      ProductImage[]
  variants    ProductVariant[]
  reviews     Review[]
  wishlist    WishlistItem[]
  orderItems  OrderItem[]
}

// Image slots. `url` stays empty until real photography is uploaded;
// the storefront renders a labelled placeholder in the meantime.
model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String?
  alt       String // e.g. Front, Back, Detail
  sortOrder Int     @default(0)
}

// Stock is tracked per size + colour combination.
model ProductVariant {
  id         Int                 @id @default(autoincrement())
  productId  Int
  product    Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  size       String
  colour     String
  colourHex  String?
  sku        String              @unique
  stock      Int                 @default(0)
  orderItems OrderItem[]
  movements  InventoryMovement[]

  @@unique([productId, size, colour])
}

model InventoryMovement {
  id        Int            @id @default(autoincrement())
  variantId Int
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  change    Int // negative = stock out
  reason    String // ORDER | CANCEL | RETURN | RESTOCK | ADJUSTMENT
  note      String?
  createdAt DateTime       @default(now())
}

model Review {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  rating    Int // 1 - 5
  comment   String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ---------- Orders ----------

model Order {
  id             Int                  @id @default(autoincrement())
  orderNumber    String               @unique
  accessToken    String // lets a guest view their confirmation page
  idempotencyKey String?              @unique // blocks duplicate submissions
  userId         Int?
  user           User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  name           String
  email          String
  phone          String
  line1          String
  line2          String?
  city           String
  district       String
  postalCode     String?
  billingAddress String? // JSON, only when different from delivery
  deliveryMethod String               @default("STANDARD") // STANDARD | EXPRESS | PICKUP
  subtotal       Int
  discount       Int                  @default(0)
  deliveryFee    Int                  @default(0)
  total          Int
  couponCode     String?
  paymentMethod  String // COD | BANK_TRANSFER | CARD
  paymentStatus  String               @default("PENDING") // PENDING | PAID | FAILED | REFUNDED | PARTIALLY_REFUNDED
  // PENDING_PAYMENT | RECEIVED | CONFIRMED | PROCESSING | SHIPPED | DELIVERED | CANCELLED | RETURNED
  status         String               @default("RECEIVED")
  notes          String?
  estimatedDays  String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  items          OrderItem[]
  history        OrderStatusHistory[]
  payments       Payment[]
  refunds        Refund[]
  shipment       Shipment?
}

// Snapshot of the product at purchase time, so later edits don't change old orders.
model OrderItem {
  id          Int             @id @default(autoincrement())
  orderId     Int
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int?
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId   Int?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName String
  sku         String
  size        String
  colour      String
  unitPrice   Int
  quantity    Int
}

model OrderStatusHistory {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  changedBy String?
  createdAt DateTime @default(now())
}

// Payment references only. Card numbers / CVV are never stored here;
// online payments go through the gateway's hosted checkout.
model Payment {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method    String // COD | BANK_TRANSFER | CARD
  amount    Int
  status    String   @default("PENDING") // PENDING | PAID | FAILED
  reference String? // gateway transaction id / bank slip reference
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Refund {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount    Int
  reason    String
  status    String   @default("REQUESTED") // REQUESTED | APPROVED | PROCESSED | REJECTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Shipment {
  id             Int       @id @default(autoincrement())
  orderId        Int       @unique
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier        String?
  trackingNumber String?
  status         String    @default("PENDING") // PENDING | SHIPPED | DELIVERED | FAILED | RETURNED
  shippedAt      DateTime?
  deliveredAt    DateTime?
  note           String?
}

// ---------- Promotions, shipping & settings ----------

model Coupon {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  description String?
  type        String    @default("PERCENT") // PERCENT | FIXED
  value       Int
  minOrder    Int       @default(0)
  maxUses     Int?
  usedCount   Int       @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

model ShippingRate {
  id            Int     @id @default(autoincrement())
  district      String  @unique
  fee           Int
  codAvailable  Boolean @default(true)
  estimatedDays String  @default("2-4")
}

model Setting {
  key   String @id
  value String
}

model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  consent   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}
