{
  "name": "clothing-store",
  "version": "1.0.0",
  "private": true,
  "description": "Clothing store e-commerce website (HTML/CSS storefront, Express API, Prisma database) by E-POCH IT Solutions",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "setup": "npm install && prisma migrate dev --name init && prisma db seed"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "prisma": "^6.16.0"
  },
  "engines": {
    "node": ">=18"
  }
}
